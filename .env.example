# === Required API Keys ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...
BRAVE_API_KEY=BSA...

# === Optional: Enhanced Search ===
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# === Optional: Neo4j Graph DB ===
NEO4J_URI=neo4j+s://...
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# === Optional: LangSmith Tracing ===
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=elile-research-agent
LANGCHAIN_TRACING_V2=true

# === Optional: Confidence Formula Weights ===
# Defaults: authority=0.35, corroboration=0.30, recency=0.15, consistency=0.20
CONFIDENCE_WEIGHT_AUTHORITY=
CONFIDENCE_WEIGHT_CORROBORATION=
CONFIDENCE_WEIGHT_RECENCY=
CONFIDENCE_WEIGHT_CONSISTENCY=

# === Optional: Budget Overrides ===
DEFAULT_MAX_ITERATIONS=8
DEFAULT_MAX_SEARCH_CALLS=60
DEFAULT_MAX_DOLLARS=5.0
DEFAULT_MAX_SECONDS_PER_ITERATION=180
